{
  "name": "@goal-app/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src --ext .ts",
    "openapi:generate": "tsc -p tsconfig.build.json && node dist/generate-openapi.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:swagger-dev": "node --import tsx src/swagger-development-smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json"
  },
  "dependencies": {
    "@goal-app/contracts": "workspace:*",
    "@goal-app/jobs": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.6",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/functions": "3.9.3",
    "@vercel/queue": "0.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.1.3",
    "openai": "7.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
