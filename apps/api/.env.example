NODE_ENV=development
APP_ENV=nonprod
PORT=4000
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SWAGGER_ENABLED=true
LOG_LEVEL=debug
TRUST_PROXY=false
BODY_LIMIT=1mb
CRON_SECRET=replace-with-at-least-16-random-characters

# Use the Supabase Cloud project URL and API keys from its Dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Hosted nonprod/prod: use an sb_secret_... key. Never expose it to Web or Mobile.
SUPABASE_SECRET_KEY=

APPLE_CLIENT_ID=th.co.goal.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=

# API running on your computer syncs into Supabase Cloud; ignored in production/Vercel.
FOOTBALL_LOCAL_AUTO_SYNC=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_MS=120000
NEWS_ALLOWED_DOMAINS=bbc.com,skysports.com,reuters.com,apnews.com,espn.com,fifa.com,uefa.com,premierleague.com
NEWS_GLOBAL_TOPICS=football breaking news,football injuries,football transfers
NEWS_INGESTION_LANGUAGES=th,en
NEWS_MAX_TOPICS_PER_RUN=25
NEWS_SYSTEM_DAILY_LIMIT=100
AI_DAILY_REQUEST_LIMIT=20
AI_SYSTEM_DAILY_LIMIT=100
AI_AUTO_LEAGUE_IDS=
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_BASE_URL=https://exp.host/--/api/v2
EXPO_PUSH_TIMEOUT_MS=8000
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TIMEOUT_MS=8000
API_FOOTBALL_LEAGUE_IDS=
FOOTBALL_LIVE_INTERVAL_SECONDS=60
FOOTBALL_DETAIL_BATCH_SIZE=20
