{
  "expo": {
    "name": "Goal",
    "slug": "goal",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "goal",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "th.co.goal.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "th.co.goal.app",
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD700",
          "defaultChannel": "match-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
